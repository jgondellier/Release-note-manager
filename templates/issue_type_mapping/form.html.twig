{% extends 'base.html.twig' %}

{% block title %}Correspondance de type{% endblock %}
{% block breadcrumbs %}<a href="{{ path('mapping_index') }}">Types de tickets</a> › {{ is_new ? 'Nouvelle' : mapping.jiraIssueType }}{% endblock %}

{% block body %}
<div class="page-header"><h1>{{ is_new ? 'Nouvelle correspondance' : 'Modifier la correspondance' }}</h1></div>
<section class="card narrow">
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_widget(form) }}
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-ghost" href="{{ path('mapping_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
