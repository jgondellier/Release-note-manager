{% extends 'base.html.twig' %}

{% block title %}Informations — {{ release.title }}{% endblock %}
{% block breadcrumbs %}<a href="{{ path('release_show', {id: release.id}) }}">{{ release.title }}</a> › Informations{% endblock %}

{% block body %}
<div class="page-header"><h1>Informations et introductions</h1></div>
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
<div class="grid grid-2">
    <section class="card">
        <h2>Release</h2>
        {{ form_row(form.title) }}
        {{ form_row(form.releaseDate) }}
        {% if form.status is defined %}{{ form_row(form.status) }}{% else %}<p class="small muted">Statut calculé par les publications : {{ release.status.label }}.</p>{% endif %}
        <dl class="dl small">
            <dt>Version Jira</dt><dd>{{ release.jiraVersionName }} (n°{{ release.jiraVersionId }})</dd>
            {% if release.jiraVersionReleaseDate %}<dt>Date Jira</dt><dd>{{ release.jiraVersionReleaseDate|date('d/m/Y') }}</dd>{% endif %}
            {% if release.jiraVersionDescription %}<dt>Description Jira</dt><dd>{{ release.jiraVersionDescription }}</dd>{% endif %}
        </dl>
        {{ form_row(form.usefulLinks) }}
    </section>
    <section class="card">
        <h2>Introductions par format</h2>
        <div class="tabs" role="tablist" data-tabs>
            <button type="button" class="tab active" data-tab="intro-it">IT</button>
            <button type="button" class="tab" data-tab="intro-functional">Fonctionnel</button>
            <button type="button" class="tab" data-tab="intro-communication">Communication</button>
        </div>
        <div data-tab-panel="intro-it">{{ form_row(form.itIntro) }}</div>
        <div data-tab-panel="intro-functional" hidden>{{ form_row(form.functionalIntro) }}</div>
        <div data-tab-panel="intro-communication" hidden>{{ form_row(form.communicationTitle) }}{{ form_row(form.communicationIntro) }}</div>
    </section>
</div>
<div class="form-actions sticky-actions">
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a class="btn btn-ghost" href="{{ path('release_show', {id: release.id}) }}">Annuler</a>
</div>
{{ form_end(form) }}
{% endblock %}
