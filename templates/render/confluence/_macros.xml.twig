{# Macros Confluence (format de stockage) communes à Cloud et Server/Data Center.
   Les paramètres « body » reçoivent du XHTML déjà assaini (filtre rn_text ou bloc {% set %}
   dont les valeurs sont échappées) : ils sont donc insérés avec |raw pour ne pas être ré-échappés. #}

{% macro status(title, colour = 'Grey') -%}
<ac:structured-macro ac:name="status"><ac:parameter ac:name="colour">{{ colour }}</ac:parameter><ac:parameter ac:name="title">{{ title }}</ac:parameter></ac:structured-macro>
{%- endmacro %}

{# kind : info | note | tip | warning #}
{% macro callout(kind, title, body) -%}
{% if body %}<ac:structured-macro ac:name="{{ kind }}">{% if title %}<ac:parameter ac:name="title">{{ title }}</ac:parameter>{% endif %}<ac:rich-text-body>{{ body|raw }}</ac:rich-text-body></ac:structured-macro>{% endif %}
{%- endmacro %}

{% macro panel(title, body, bg = '#F4F5F7', border = '#DFE1E6') -%}
<ac:structured-macro ac:name="panel">{% if title %}<ac:parameter ac:name="title">{{ title }}</ac:parameter>{% endif %}<ac:parameter ac:name="bgColor">{{ bg }}</ac:parameter><ac:parameter ac:name="borderColor">{{ border }}</ac:parameter><ac:parameter ac:name="borderStyle">solid</ac:parameter><ac:rich-text-body>{{ body|raw }}</ac:rich-text-body></ac:structured-macro>
{%- endmacro %}

{% macro toc() -%}
<ac:structured-macro ac:name="toc"><ac:parameter ac:name="maxLevel">2</ac:parameter><ac:parameter ac:name="minLevel">2</ac:parameter></ac:structured-macro>
{%- endmacro %}

{% macro expand(title, body) -%}
<ac:structured-macro ac:name="expand"><ac:parameter ac:name="title">{{ title }}</ac:parameter><ac:rich-text-body>{{ body|raw }}</ac:rich-text-body></ac:structured-macro>
{%- endmacro %}

{% macro category(category) -%}
{{ _self.status(category.label, category.confluenceColour) }}
{%- endmacro %}

{% macro links(links, title = 'Liens utiles') -%}
{% if links is not empty %}<p><strong>{{ title }}</strong></p><ul>{% for l in links %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}</ul>{% endif %}
{%- endmacro %}

{% macro footer(doc) -%}
<hr /><p><sub>{{ doc.project.name }} · version {{ doc.release.jiraVersionName }}{% if doc.release.releaseDate %} · mise en production le {{ doc.release.releaseDate|date('d/m/Y') }}{% endif %} · page générée par Release Note Manager. Les modifications manuelles de cette page seront remplacées lors de la prochaine publication.</sub></p>
{%- endmacro %}
