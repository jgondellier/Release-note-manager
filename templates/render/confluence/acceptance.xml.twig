{% import 'render/confluence/_macros.xml.twig' as c %}
{% macro period(start, end) -%}
    {%- if start and end and start != end -%}Du {{ start|date('d/m/Y') }} au {{ end|date('d/m/Y') }}
    {%- elseif start or end -%}{{ (start ?: end)|date('d/m/Y') }}
    {%- else -%}N/A{%- endif -%}
{%- endmacro %}
{% macro cov_badges(groups, total, executed) -%}
    {%- import 'render/confluence/_macros.xml.twig' as c -%}
    {%- set colours = {passed: 'Green', failed: 'Red', needsAttention: 'Yellow', planned: 'Blue', skipped: 'Purple'} -%}
    {%- for g in groups %} {{ c.status(g.count ~ ' ' ~ g.name, colours[g.id] ?? 'Grey') }}{% endfor -%}
    {%- if total > executed %} {{ c.status((total - executed) ~ ' sans passage', 'Grey') }}{% endif -%}
{%- endmacro %}
{% macro coverage(cov) -%}
    {%- if cov is null -%}<em>Indisponible</em>
    {%- elseif cov.status == 'hasData' -%}
        {%- if cov.entity and cov.entity.testTabUrl -%}<a href="{{ cov.entity.testTabUrl }}">{{ cov.totalTests }} test{{ cov.totalTests > 1 ? 's' }}</a>{%- else -%}{{ cov.totalTests }} test{{ cov.totalTests > 1 ? 's' }}{%- endif -%}
        {{ _self.cov_badges(cov.groups, cov.totalTests, cov.executedTests) }}
    {%- elseif cov.status == 'noData' -%}<em>Aucune entité Octane</em>
    {%- elseif cov.status == 'exceedsMaxTotalCount' -%}<em>Trop de tests pour le calcul</em>
    {%- else -%}<em>Non configurée</em>{%- endif -%}
{%- endmacro %}
{% import _self as m %}
{% set cov_summary = pv.coverageSummary %}
{% set scope = pv.scopeItems %}
{% set tests = pv.testItems %}
{% set anomalies = pv.anomalyItems %}
{% set header %}
<p><strong>Procès-verbal de tests système</strong></p>
<p>{{ c.status(pv.documentStatus.label|upper, pv.documentStatus.confluenceColour) }} {{ c.status(pv.versionLabel, 'Blue') }}{% if pv.mepDate %} {{ c.status('MEP ' ~ pv.mepDate|date('d/m/Y'), 'Grey') }}{% endif %}{% if pv.decision %} {{ c.status(pv.decision.label, pv.decision.confluenceColour) }}{% endif %}</p>
{% endset %}
{{ c.panel(pv.documentTitle, header, '#EAF0FB', '#2451B7') }}
{{ c.toc() }}

<h2>1. Identification de la recette</h2>
<table><tbody>
<tr><th>Projet / Application / Plan produit / Chantier</th><td>{{ pv.applicationName }}</td></tr>
{% if pv.code %}<tr><th>Code</th><td><code>{{ pv.code }}</code></td></tr>{% endif %}
<tr><th>Version</th><td>{{ pv.versionLabel }}</td></tr>
<tr><th>Date MEP</th><td>{{ pv.mepDate ? pv.mepDate|date('d/m/Y') : '—' }}</td></tr>
{% if pv.subject %}<tr><th>Objet</th><td>{{ pv.subject|rn_text }}</td></tr>{% endif %}
<tr><th>Responsable(s) de la recette</th><td>{% if pv.acceptanceManagerList is empty %}—{% else %}<ul>{% for p in pv.acceptanceManagerList %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}</td></tr>
<tr><th>Responsable(s) de la livraison</th><td>{% if pv.deliveryManagerList is empty %}—{% else %}<ul>{% for p in pv.deliveryManagerList %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}</td></tr>
</tbody></table>

<h2>2. Description des tests effectués</h2>
<h3>2.1 Déroulement de la recette</h3>
{% if pv.phases is empty %}<p><em>Aucune phase renseignée.</em></p>{% else %}
<table><tbody>
<tr><th>Jalon / Phase</th><th>Dates prévues</th><th>Dates réelles</th><th>Environnements</th><th>Commentaire</th></tr>
{% for p in pv.phases %}
<tr><td><strong>{{ p.phase }}</strong></td><td>{{ m.period(p.plannedStart, p.plannedEnd) }}</td><td>{{ m.period(p.actualStart, p.actualEnd) }}</td><td>{{ p.environment }}</td><td>{{ p.comment }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}

<h3>2.2 Description du périmètre</h3>
<p>{{ c.status(scope|length ~ ' fiche(s) testée(s)', 'Blue') }} {{ c.status(tests|length ~ ' exécution(s) documentée(s)', 'Purple') }} {{ c.status(anomalies|length ~ ' anomalie(s)', anomalies is empty ? 'Green' : 'Red') }}</p>
{% if cov_summary is not null %}
{% set levels = rn_coverage_levels() %}
{% set colours = {passed: 'Green', failed: 'Red', needsAttention: 'Yellow', planned: 'Blue', skipped: 'Purple', none: 'Grey'} %}
<h4>Couverture de tests Octane</h4>
{% if cov_summary.withData > 0 %}
<p><strong>{{ cov_summary.totalTests }} test{{ cov_summary.totalTests > 1 ? 's' }}</strong> liés à {{ cov_summary.withData }} fiche{{ cov_summary.withData > 1 ? 's' }} sur {{ scope|length }}.</p>
<table><tbody>
<tr><th>Résultat du dernier passage</th><th>Tests</th><th>%</th></tr>
{% for r in rn_coverage_rows(cov_summary) %}
<tr><td>{{ c.status(r.name, colours[r.id] ?? 'Grey') }}</td><td>{{ r.count }}</td><td>{{ r.percent|number_format(1, ',') }} %</td></tr>
{% endfor %}
<tr><th>Total</th><th>{{ cov_summary.totalTests }}</th><th>100 %</th></tr>
</tbody></table>
{% else %}
<p>Aucune fiche du périmètre n'est liée à des tests dans Octane.</p>
{% endif %}
<p>{% for level, def in levels %}{% set n = scope|filter(i => rn_coverage_health(i.coverage ?? null) == level)|length %}{{ c.status(def.label ~ ' : ' ~ n, def.colour) }} {% endfor %}</p>
{% if pv.coverageError %}<p><em>Couverture partielle : {{ pv.coverageError }}</em></p>{% endif %}
{% endif %}
<h4>Périmètre de tests</h4>
{% if scope is empty %}<p><em>Aucune fiche dans le périmètre.</em></p>{% else %}
<table><tbody>
<tr><th>Clé</th><th>Type</th><th>Résumé</th><th>Statut</th>{% if cov_summary is not null %}<th>Couverture Octane</th>{% endif %}</tr>
{% for i in scope %}
<tr><td><a href="{{ i.url }}">{{ i.key }}</a></td><td>{{ i.type }}</td><td>{{ i.summary }}</td><td>{{ c.status(i.status ?? '?', i.statusCategory == 'done' ? 'Green' : 'Grey') }}</td>{% if cov_summary is not null %}{% set h = rn_coverage_health(i.coverage ?? null) %}{% set hl = {passed: 'green', failed: 'red', warning: 'yellow', none: 'grey'}[h] %}<td class="highlight-{{ hl }}" data-highlight-colour="{{ hl }}">{{ c.status(rn_coverage_levels()[h].label, rn_coverage_levels()[h].colour) }} {{ m.coverage(i.coverage ?? null) }}</td>{% endif %}</tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if pv.scopeIntro %}{{ pv.scopeIntro|rn_text }}{% endif %}
{{ c.callout('note', 'Hors périmètre de tests', pv.outOfScope ? pv.outOfScope|rn_text : '<p>N/A</p>') }}

<h3>2.2.1 Exécution des tests recette</h3>
{% for t in tests %}
{% set body %}
{% for cm in t.comments %}
<p><strong>{{ cm.author ?? 'Auteur inconnu' }}</strong>{% if cm.date %} — {{ cm.date|date('d/m/Y H:i') }}{% endif %}</p>
{{ cm.text|rn_text }}
{% if not loop.last %}<hr />{% endif %}
{% endfor %}
{% endset %}
<h4><a href="{{ t.url }}">{{ t.key }}</a> — {{ t.summary }} {{ c.status(t.status ?? '?', t.statusCategory == 'done' ? 'Green' : 'Grey') }}</h4>
{{ c.panel(null, body, '#FFFFFF', '#DFE1E6') }}
{% else %}
<p><em>Aucun commentaire de test (préfixe « {{ pv.testCommentPrefix }} ») sur les fiches du périmètre.</em></p>
{% endfor %}

<h3>2.2.2 Anomalies détectées</h3>
{% set n = anomalies|length %}
<p><strong>{{ n }} anomalie{{ n > 1 ? 's' }} détectée{{ n > 1 ? 's' }}</strong>{% if n > 0 %} ({{ n - anomalies_linked }} de la version, {{ anomalies_linked }} liée{{ anomalies_linked > 1 ? 's' }} aux fiches du périmètre) : {{ c.status(anomalies_done ~ ' terminée' ~ (anomalies_done > 1 ? 's' : ''), 'Green') }} {{ c.status(anomalies_open_list|length ~ ' non terminée' ~ (anomalies_open_list|length > 1 ? 's' : ''), anomalies_open_list is empty ? 'Grey' : 'Red') }}{% endif %}</p>
{% if pv.anomaliesComment %}{{ pv.anomaliesComment|rn_text }}{% endif %}
{% for group in [{title: 'Anomalies non terminées', items: anomalies_open_list, open: true}, {title: 'Anomalies terminées', items: anomalies_done_list, open: false}] %}
{% if group.items is not empty %}
{% set table %}
<table><tbody>
<tr><th>Clé</th><th>Résumé</th><th>Origine</th><th>Priorité</th><th>Statut</th><th>Résolution</th></tr>
{% for a in group.items %}
<tr><td><a href="{{ a.url }}">{{ a.key }}</a></td><td>{{ a.summary }}</td><td>{% if (a.origin ?? 'version') == 'linked' %}Liée à {{ a.linkedFrom|join(', ')|rn_inline }}{% else %}Version{% if a.linkedFrom|default([]) is not empty %} (liée à {{ a.linkedFrom|join(', ')|rn_inline }}){% endif %}{% endif %}</td><td>{{ a.priority }}</td><td>{{ c.status(a.status ?? '?', a.statusCategory == 'done' ? 'Green' : 'Red') }}</td><td>{{ a.resolution ?? '—' }}</td></tr>
{% endfor %}
</tbody></table>
{% endset %}
{% if group.open %}{{ c.callout('warning', group.title ~ ' (' ~ group.items|length ~ ')', table) }}{% else %}<h4>{{ group.title }} ({{ group.items|length }})</h4>{{ table }}{% endif %}
{% endif %}
{% endfor %}

<h2>3. Conclusion de la recette</h2>
<table><tbody>
<tr><th>Décision</th><th>Réserves</th></tr>
<tr><td>
{% for d in enum_cases('App\\Enum\\AcceptanceDecision') %}
<p>{% if pv.decision == d %}<ac:emoticon ac:name="tick" /> <strong>{{ d.label }}</strong>{% else %}☐ {{ d.label }}{% endif %}</p>
{% endfor %}
</td><td>{{ pv.reserves ? pv.reserves|rn_text : '<p>—</p>' }}</td></tr>
</tbody></table>
{{ c.callout('info', 'Commentaires', pv.comments ? pv.comments|rn_text : null) }}

<h2>4. Signatures</h2>
<table><tbody>
<tr><th>Responsable de la livraison</th><th>Responsable de la recette</th></tr>
<tr>
<td><p><strong>Nom :</strong> {{ pv.deliverySignatory ?? '' }}</p><p><strong>Date :</strong> {{ pv.deliverySignedAt ? pv.deliverySignedAt|date('d/m/Y') : '' }}</p></td>
<td><p><strong>Nom :</strong> {{ pv.acceptanceSignatory ?? '' }}</p><p><strong>Date :</strong> {{ pv.acceptanceSignedAt ? pv.acceptanceSignedAt|date('d/m/Y') : '' }}</p></td>
</tr>
</tbody></table>
<hr /><p><sub>{{ release.project.name }} · version {{ release.jiraVersionName }}{% if pv.jiraSyncedAt %} · données Jira extraites le {{ pv.jiraSyncedAt|date('d/m/Y à H:i') }}{% endif %} · page générée par Release Note Manager. Les modifications manuelles de cette page seront remplacées lors de la prochaine publication.</sub></p>
