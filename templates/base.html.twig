<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Tableau de bord{% endblock %} · Release Note Manager</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232451B7'/%3E%3Cpath d='M9 9h10l4 4v10H9z' fill='white'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/release-note.css') }}">
    {% block stylesheets %}{% endblock %}
    <script src="{{ asset('assets/js/app.js') }}" defer></script>
</head>
<body class="{% block body_class %}{% endblock %}">
{% if app.user %}
<div class="layout">
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="{{ path('app_dashboard') }}">
            <span class="brand-mark" aria-hidden="true">RN</span>
            <span>Release Note<br><small>Manager</small></span>
        </a>
        {% set route = app.request.attributes.get('_route') ?? '' %}
        <nav class="nav" aria-label="Navigation principale">
            <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}"><span aria-hidden="true">◧</span> Tableau de bord</a>
            <a href="{{ path('release_index') }}" class="{{ route starts with 'release' or route starts with 'section' or route starts with 'ticket' or route starts with 'publication' ? 'active' }}"><span aria-hidden="true">☰</span> Release notes</a>
            <a href="{{ path('release_new') }}" class="nav-cta"><span aria-hidden="true">＋</span> Nouvelle release</a>
            <div class="nav-title">Administration</div>
            <a href="{{ path('project_index') }}" class="{{ route starts with 'project' ? 'active' }}"><span aria-hidden="true">▣</span> Projets</a>
            <a href="{{ path('connection_index') }}" class="{{ route starts with 'connection' ? 'active' }}"><span aria-hidden="true">⇄</span> Connexions</a>
            <a href="{{ path('mapping_index') }}" class="{{ route starts with 'mapping' ? 'active' }}"><span aria-hidden="true">≡</span> Types de tickets</a>
            <a href="{{ path('label_mapping_index') }}" class="{{ route starts with 'label_mapping' ? 'active' }}"><span aria-hidden="true">#</span> Étiquettes</a>
        </nav>
        <form method="post" action="{{ path('app_logout') }}" class="logout">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="btn btn-ghost btn-block">Déconnexion</button>
        </form>
    </aside>
    <div class="main">
        <header class="topbar">
            <button type="button" class="btn btn-ghost menu-toggle" data-toggle-sidebar aria-controls="sidebar" aria-expanded="false">☰ Menu</button>
            <div class="breadcrumbs">{% block breadcrumbs %}{% endblock %}</div>
        </header>
        <main class="content">
            {% include '_components/flashes.html.twig' %}
            {% block body %}{% endblock %}
        </main>
    </div>
</div>
{% else %}
    {% block anonymous %}{% endblock %}
{% endif %}
{% block javascripts %}{% endblock %}
</body>
</html>
