{% extends 'base.html.twig' %}

{% block title %}Confirmer la publication{% endblock %}
{% block breadcrumbs %}<a href="{{ path('release_show', {id: release.id}) }}">{{ release.title }}</a> › Confirmation{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Confirmer la publication</h1>
        <p class="muted">Release : <strong>{{ release.displayName }}</strong> — {{ rows|length }} cible(s).</p>
    </div>
</div>
<div class="alert alert-info">Sur chaque instance, les pages sont rangées sous une page de regroupement « {{ rows|first.containerTitle }} », créée automatiquement si nécessaire. Les pages publiées auparavant ailleurs y sont déplacées.</div>
<section class="card">
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Release</th><th>Format</th><th>Destination</th><th>Espace et emplacement</th><th>Titre de la page</th><th>Résultat attendu</th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ release.jiraVersionName }}</td>
                    <td><strong>{{ row.format.label }}</strong></td>
                    <td>{{ row.target.label }}<br><span class="small muted">{{ row.connectionName }}</span></td>
                    <td>{{ row.spaceKey }}<br><span class="small muted">{{ row.locationLabel }}</span></td>
                    <td>{{ row.pageTitle }}</td>
                    <td class="small">{{ row.expectedOutcome }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <form method="post" action="{{ path('publication_execute', {id: release.id}) }}" data-busy="Publication en cours…">
        <input type="hidden" name="_token" value="{{ csrf_token('publication-execute-' ~ release.id) }}">
        {% for row in rows %}<input type="hidden" name="targets[]" value="{{ row.key }}">{% endfor %}
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Publier maintenant</button>
            <a class="btn btn-ghost" href="{{ path('publication_select', {id: release.id}) }}">← Modifier la sélection</a>
        </div>
    </form>
</section>
{% endblock %}
