{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}{%- set widget_attr = {attr: attr|merge({'aria-describedby': id ~ '_help'})} -%}{%- endif -%}
    <div class="field{% if errors|length > 0 %} has-error{% endif %}{% if required %} is-required{% endif %}">
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="field field-check{% if errors|length > 0 %} has-error{% endif %}">
        <label class="check">{{ form_widget(form) }} <span>{{ label }}</span></label>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block choice_widget_expanded %}
    <div class="segmented" {{ block('widget_container_attributes') }}>
        {% for child in form %}
            <label class="segment">{{ form_widget(child) }}<span>{{ child.vars.label }}</span></label>
        {% endfor %}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="field-errors">{% for error in errors %}<li>{{ error.message }}</li>{% endfor %}</ul>
    {% endif %}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}<p id="{{ id }}_help" class="field-help">{{ help }}</p>{% endif %}
{% endblock %}
