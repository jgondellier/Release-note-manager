# Valeurs par défaut NON SECRÈTES, versionnées.
# Surchargez-les dans .env.local (non versionné) ou par de vraies variables d'environnement.
# Voir .env.example pour la liste commentée de toutes les variables.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://rnm:change_me@127.0.0.1:3306/release_notes?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> Release Note Manager ###
# Token d'administration (>= 32 caractères). Vide = connexion impossible.
ADMIN_TOKEN=
# Clé de chiffrement des secrets Jira/Confluence (base64 de 32 octets).
# Générer avec : php bin/console app:encryption:generate-key
APP_ENCRYPTION_KEY=
# Proxy HTTP d'entreprise pour les appels Jira/Confluence (vide = aucun / variables système).
APP_HTTP_PROXY=
APP_HTTP_NO_PROXY=
# Fichier d'autorités de certification (CA d'entreprise), vide = magasin système.
APP_HTTP_CAFILE=
APP_HTTP_VERIFY_PEER=1
# Délai d'inactivité (secondes) et durée max d'un appel HTTP externe.
APP_HTTP_TIMEOUT=15
APP_HTTP_MAX_DURATION=60
###< Release Note Manager ###
