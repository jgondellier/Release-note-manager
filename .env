# Valeurs par défaut NON SECRÈTES, versionnées.
# Surchargez-les dans .env.local (non versionné) ou par de vraies variables d'environnement.
# Voir .env.example pour la liste commentée de toutes les variables.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://rnm:change_me@127.0.0.1:3306/release_notes?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> Release Note Manager ###
# Token d'administration (>= 32 caractères). Vide = connexion impossible.
ADMIN_TOKEN=
# Clé de chiffrement des secrets Jira/Confluence (base64 de 32 octets).
# Générer avec : php bin/console app:encryption:generate-key
APP_ENCRYPTION_KEY=
# Proxy HTTP d'entreprise pour les appels Jira/Confluence (vide = aucun / variables système).
APP_HTTP_PROXY=
APP_HTTP_NO_PROXY=
# Fichier d'autorités de certification (CA d'entreprise), vide = magasin système.
APP_HTTP_CAFILE=
APP_HTTP_VERIFY_PEER=1
# Délai d'inactivité (secondes) et durée max d'un appel HTTP externe.
APP_HTTP_TIMEOUT=15
APP_HTTP_MAX_DURATION=60
###< Release Note Manager ###

###> Mises à jour de l'application (menu « Mises à jour ») ###
# Jeton GitHub (dépôt privé, droit « Contents: read ») : à mettre dans .env.local, jamais ici.
# GITHUB_TOKEN=github_pat_xxx
# Exécutable PHP pour les commandes. Sous EasyPHP / Apache, renseignez-le, ex. C:/EasyPHP/eds-binaries/php/php829vs16x64/php.exe
RNM_UPDATE_PHP_BINARY=
# Commande Composer. Vide : « php composer.phar » si composer.phar est à la racine ou à côté de php.exe, sinon « composer ».
# Ex. : "{php} C:/composer/composer.phar" ({php} = RNM_UPDATE_PHP_BINARY)
RNM_UPDATE_COMPOSER=
# Durée maximale d'une commande (s, 0 = illimitée).
RNM_UPDATE_COMMAND_TIMEOUT=1800
# Sauvegardes des fichiers remplacés conservées (var/local-updates/backups).
RNM_UPDATE_BACKUPS_KEPT=5
# 1 : mise à jour dans un processus séparé (journal en direct) ; 0 : dans la requête.
RNM_UPDATE_BACKGROUND=1
# Téléchargement de l'archive : proxy, certificat racine de l'entreprise (PEM ou DER), vérification SSL.
RNM_UPDATE_PROXY=
RNM_UPDATE_CAFILE=
RNM_UPDATE_VERIFY_SSL=1
# 1 : écran accessible depuis un autre poste (déconseillé : il lance des commandes sur ce poste).
RNM_UPDATE_ALLOW_REMOTE=0
###< Mises à jour de l'application ###
