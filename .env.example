# ---------------------------------------------------------------------------
# Release Note Manager — modèle de configuration
# Copiez ce fichier en .env.local et renseignez les valeurs. Ne versionnez
# JAMAIS .env.local : il contient des secrets.
# ---------------------------------------------------------------------------

# Environnement : dev | prod
APP_ENV=prod
APP_DEBUG=0

# Secret Symfony (signature CSRF, sessions). 32+ caractères aléatoires :
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=remplacez_moi

# Connexion MySQL 8 (adapter utilisateur, mot de passe, hôte, base).
# Encodez en URL les caractères spéciaux du mot de passe (@ -> %40, etc.).
DATABASE_URL="mysql://rnm:mot_de_passe@127.0.0.1:3306/release_notes?serverVersion=8.0.32&charset=utf8mb4"
# MariaDB : DATABASE_URL="mysql://rnm:mdp@127.0.0.1:3306/release_notes?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

# Token d'administration (connexion à l'interface). 32 caractères minimum :
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Rotation : remplacer la valeur puis vider le cache (php bin/console cache:clear).
ADMIN_TOKEN=remplacez_moi_par_un_token_long_et_aleatoire

# Clé de chiffrement des secrets Jira/Confluence stockés en base (libsodium).
# Générer : php bin/console app:encryption:generate-key
# Rotation : php bin/console app:encryption:rotate-key --old-key=ANCIENNE --new-key=NOUVELLE
APP_ENCRYPTION_KEY=

# Proxy d'entreprise (laisser vide si accès direct).
# Exemple : APP_HTTP_PROXY=http://utilisateur:motdepasse@proxy.entreprise.local:8080
APP_HTTP_PROXY=
# Hôtes joignables sans proxy, séparés par des virgules (ex : jira.interne.local,.corp.local)
APP_HTTP_NO_PROXY=
# Chemin d'un bundle CA PEM si le proxy réalise une inspection TLS.
APP_HTTP_CAFILE=
# 1 = vérification TLS active (recommandé). Ne désactivez qu'en diagnostic ponctuel.
APP_HTTP_VERIFY_PEER=1
APP_HTTP_TIMEOUT=15
APP_HTTP_MAX_DURATION=60

# Derrière un reverse proxy, liste des IP de confiance (ex : 127.0.0.1,REMOTE_ADDR)
# TRUSTED_PROXIES=127.0.0.1
